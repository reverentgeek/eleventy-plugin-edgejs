{
	"name": "eleventy-plugin-edgejs",
	"version": "1.1.34",
	"description": "Eleventy plugin for Edge.js templating",
	"type": "module",
	"main": "edgeJsPlugin.js",
	"exports": {
		".": "./edgeJsPlugin.js"
	},
	"files": [
		"edgeJsPlugin.js"
	],
	"scripts": {
		"build:example": "npx @11ty/eleventy --input=example/src --config=example/eleventy.config.js",
		"lint": "eslint . --fix",
		"start:example": "npx @11ty/eleventy --input=example/src --config=example/eleventy.config.js --serve",
		"test": "node --test"
	},
	"keywords": [
		"eleventy",
		"eleventy-plugin",
		"edge",
		"edgejs",
		"template-engine"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"author": "David Neal <david@reverentgeek.com> (https://reverentgeek.com)",
	"repository": {
		"type": "git",
		"url": "https://github.com/reverentgeek/eleventy-plugin-edgejs"
	},
	"bugs": {
		"url": "https://github.com/reverentgeek/eleventy-plugin-edgejs/issues"
	},
	"homepage": "https://github.com/reverentgeek/eleventy-plugin-edgejs#readme",
	"license": "MIT",
	"dependencies": {
		"edge.js": "^6.5.1"
	},
	"peerDependencies": {
		"@11ty/eleventy": "^3.0.0 || ^4.0.0"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.8",
		"eslint": "^10.14.0",
		"eslint-config-reverentgeek": "^7.2.2"
	},
	"allowScripts": {
		"fsevents@2.3.3": true
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
